{
  "name": "squarefi-bff-api-module",
  "version": "1.36.118",
  "description": "Squarefi BFF API client module",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/squarefi-tech/bff-api-module-npm.git"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "husky",
    "test": "jest",
    "update:types": "ts-node scripts/generate-openapi-types.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "tsc --noEmit"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "node"
          }
        }
      ]
    }
  },
  "keywords": [
    "squarefi",
    "api",
    "client",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "@telegram-apps/sdk-react": "^3.1.2",
    "axios": "^1.6.7",
    "lodash.debounce": "^4.0.8",
    "node-rsa": "^1.1.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.x.x",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^20.17.47",
    "@types/node-rsa": "^1.1.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^29.x.x",
    "jest-environment-jsdom": "^29.7.0",
    "openapi-typescript": "^7.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-jest": "^29.x.x",
    "ts-node": "^10.9.2",
    "typescript": "^5.x.x"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  }
}
